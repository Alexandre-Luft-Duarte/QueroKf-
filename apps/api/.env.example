# ── Banco de dados ───────────────────────────────────────────────────────────
# No Supabase: Project Settings → Database → Connection string
#
# DATABASE_URL  = "Transaction pooler" (porta 6543) — usada pela API em runtime
# DIRECT_URL    = "Session pooler"     (porta 5432) — usada pelas migrations e pelo seed
#
# A aba "Direct connection" do Supabase também serve para DIRECT_URL, mas no plano
# gratuito ela só responde em IPv6; o Session pooler funciona em qualquer rede.
#
# Em bancos com um único endereço (Postgres local, por exemplo), preencha só DATABASE_URL.
DATABASE_URL="postgresql://postgres.abcdefgh:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.abcdefgh:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ── Servidor ─────────────────────────────────────────────────────────────────
# Porta em que a API sobe localmente
PORT=3333

# Origens liberadas no CORS, separadas por vírgula (em branco = libera todas, use só em dev)
CORS_ORIGIN=http://localhost:3000
