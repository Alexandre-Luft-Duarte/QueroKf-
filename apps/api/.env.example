# Conexão com o Postgres (Neon, Supabase, Render, etc.)
DATABASE_URL="postgresql://usuario:senha@host:5432/querokafe?sslmode=require"

# Porta em que a API sobe localmente
PORT=3333

# Origens liberadas no CORS, separadas por vírgula (em branco = libera todas, use só em dev)
CORS_ORIGIN=http://localhost:3000
